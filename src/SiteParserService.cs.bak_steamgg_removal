        private static string ExtractFirstImage(string html, string baseUrl)
        {
            try
            {
                Match m = Regex.Match(html, @"<img[^>]+src=[""']([^""']+\.(?:jpg|jpeg|png|webp))[""'][^>]*>", RegexOptions.IgnoreCase);
                if (!m.Success) return "";
                string src = m.Groups[1].Value;
                if (src.StartsWith("//")) return "https:" + src;
                if (src.StartsWith("/"))
                {
                    try { Uri u = new Uri(baseUrl); return u.Scheme + "://" + u.Authority + src; } catch { return src; }
                }
                return src;
            }
            catch { return ""; }
        }

        private static List<SiteMirror> ExtractMirrors(string html, string baseUrl)
        {
            List<SiteMirror> mirrors = new List<SiteMirror>();
            try
            {
                MatchCollection links = Regex.Matches(html, @"<a[^>]+href=[""']([^""']+)[""'][^>]*>(.*?)</a>", RegexOptions.IgnoreCase | RegexOptions.Singleline);
                HashSet<string> seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                int pri = 0;

                foreach (Match m in links)
                {
                    string href = m.Groups[1].Value;
                    string text = StripHtmlTags(m.Groups[2].Value).ToLowerInvariant();
                    if (string.IsNullOrEmpty(href)) continue;
                    if (href.StartsWith("#")) continue;

                    if (text.Contains("magnet") || href.StartsWith("magnet:"))
                    {
                        if (seen.Add(href))
                            mirrors.Add(new SiteMirror { HostName = "Magnet", Url = href, IsDirectArchive = false, Priority = pri++ });
                        continue;
                    }

                    bool looksLikeDownload = href.IndexOf("download", StringComparison.OrdinalIgnoreCase) >= 0 ||
                                             href.IndexOf("mirror", StringComparison.OrdinalIgnoreCase) >= 0 ||
                                             href.IndexOf("/go/", StringComparison.OrdinalIgnoreCase) >= 0 ||
                                             text.Contains("indir") || text.Contains("download") || text.Contains("torrent") || text.Contains("part");
                    if (!looksLikeDownload) continue;

                    if (href.StartsWith("//")) href = "https:" + href;
                    if (href.StartsWith("/"))
                    { try { Uri u = new Uri(baseUrl); href = u.Scheme + "://" + u.Authority + href; } catch { } }
                    if (!href.StartsWith("http", StringComparison.OrdinalIgnoreCase)) continue;
                    if (seen.Add(href))
                        mirrors.Add(new SiteMirror { HostName = GetHostName(href), Url = href, IsDirectArchive = href.IndexOf(".torrent", StringComparison.OrdinalIgnoreCase) >= 0, Priority = pri++ });
                }
            }
            catch { }
            return mirrors;
        }

        private static string GetHostName(string url)
        {
            try { return new Uri(url).Host; } catch { return "mirror"; }
        }
