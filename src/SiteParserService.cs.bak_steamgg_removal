        public static List<GameProfile> FetchAllSourcesMerged(string searchQuery, int page, int perPage, out string statusMessage)
        {
            statusMessage = "";
            int[] sources = new int[] { 0, -11, -12, -13, -30, -31, -32, -33 };
            string[] names = new string[] { "SteamRIP", "FitGirl", "OvaGames", "FreeGOG", "1337x", "ElAmigos", "SkidrowCodex", "Dodi" };

            List<GameProfile>[] buckets = new List<GameProfile>[sources.Length];
            string[] statuses = new string[sources.Length];
            ManualResetEvent[] done = new ManualResetEvent[sources.Length];

            for (int i = 0; i < sources.Length; i++)
            {
                int idx = i;
                done[i] = new ManualResetEvent(false);
                ThreadPool.QueueUserWorkItem(delegate
                {
                    try
                    {
                        string st;
                        buckets[idx] = FetchLiveSiteGames(sources[idx], searchQuery, page, perPage, out st);
                        statuses[idx] = st;
                    }
                    catch { buckets[idx] = null; statuses[idx] = names[idx] + " yanıt vermedi"; }
                    finally { try { done[idx].Set(); } catch { } }
                });
            }

            try { WaitHandle.WaitAll(done, 20000); } catch { }

            List<GameProfile> merged = new List<GameProfile>();
            HashSet<string> seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            int okSources = 0;
            for (int i = 0; i < sources.Length; i++)
            {
                if (buckets[i] == null || buckets[i].Count == 0) continue;
                okSources++;
                foreach (GameProfile gp in buckets[i])
                {
                    string key = (gp.Name ?? "").Trim().ToLowerInvariant();
                    if (key.Length == 0 || !seen.Add(key)) continue;
                    if (string.IsNullOrEmpty(gp.Category)) gp.Category = names[i];
                    merged.Add(gp);
                }
            }

            statusMessage = string.Format("🌐 TÜM SİTELER: {0}/{1} kaynak yanıt verdi • {2} oyun listelendi", okSources, sources.Length, merged.Count);
            return merged;
        }

        public static List<GameProfile> FetchLiveSiteGames(int categoryId, string searchQuery, int page, int perPage, out string statusMessage)
        {
            statusMessage = "";
            if (page < 1) page = 1;
            if (perPage < 6 || perPage > 50) perPage = 24;

            string cacheKey = string.Format("{0}_{1}_{2}_{3}", categoryId, searchQuery ?? "", page, perPage);
            lock (CatalogCache)
            {
                CachedCatalog cached;
                if (CatalogCache.TryGetValue(cacheKey, out cached))
                {
                    if ((DateTime.Now - cached.Timestamp).TotalMinutes < 5)
                    {
                        statusMessage = cached.Status;
                        return new List<GameProfile>(cached.Games);
                    }
                    CatalogCache.Remove(cacheKey);
                }
            }

            List<GameProfile> results = null;

            if (categoryId == -20)
            {
                results = FetchAllSourcesMerged(searchQuery, page, perPage, out statusMessage);
            }
            else if (categoryId == -11)
            {
                results = FetchWpJsonCatalogFromBaseUrl("https://fitgirl-repacks.site", "FitGirl", 0, searchQuery, page, perPage, out statusMessage);
            }
            else if (categoryId == -12)
            {
                results = FetchWpJsonCatalogFromBaseUrl("https://www.ovagames.com", "OvaGames", 0, searchQuery, page, perPage, out statusMessage);
            }
            else if (categoryId == -13)
            {
                results = FetchWpJsonCatalogFromBaseUrl("https://freegogpcgames.com", "FreeGOG", 0, searchQuery, page, perPage, out statusMessage);
            }
            else if (categoryId == -30)
            {
                results = FetchGenericHtmlCatalog("https://1337x.to", "1337x", searchQuery, page, perPage, out statusMessage);
            }
            else if (categoryId == -31)
            {
                results = FetchWpJsonCatalogFromBaseUrl("https://elamigos.site", "ElAmigos", 0, searchQuery, page, perPage, out statusMessage);
                if (results == null || results.Count == 0)
                    results = FetchGenericHtmlCatalog("https://elamigos.site", "ElAmigos", searchQuery, page, perPage, out statusMessage);
            }
            else if (categoryId == -32)
            {
                results = FetchWpJsonCatalogFromBaseUrl("https://www.skidrowcodex.net", "SkidrowCodex", 0, searchQuery, page, perPage, out statusMessage);
                if (results == null || results.Count == 0)
                    results = FetchGenericHtmlCatalog("https://www.skidrowcodex.net", "SkidrowCodex", searchQuery, page, perPage, out statusMessage);
            }
            else if (categoryId == -33)
            {
                results = FetchWpJsonCatalogFromBaseUrl("https://dodi-repacks.site", "Dodi", 0, searchQuery, page, perPage, out statusMessage);
                if (results == null || results.Count == 0)
                    results = FetchGenericHtmlCatalog("https://dodi-repacks.site", "Dodi", searchQuery, page, perPage, out statusMessage);
            }
            else
            {
                results = FetchWpJsonCatalogFromBaseUrl("https://steamrip.com", "SteamRIP", categoryId, searchQuery, page, perPage, out statusMessage);
            }

            if (results == null) results = new List<GameProfile>();

            try { results = GameDeduplicationEngine.Deduplicate(results); } catch { }

            if (results.Count > 0)
            {
                lock (CatalogCache)
                {
                    CatalogCache[cacheKey] = new CachedCatalog
                    {
                        Timestamp = DateTime.Now,
                        Games = new List<GameProfile>(results),
                        Status = statusMessage
                    };
                }
            }

            return results;
        }

        private static List<GameProfile> FetchWpJsonCatalogFromBaseUrl(
            string baseSiteUrl, string sourceLabel, int categoryId,
            string searchQuery, int page, int perPage, out string statusMessage)
        {
            statusMessage = "";
            List<GameProfile> results = new List<GameProfile>();

            try
            {
                StringBuilder apiUrl = new StringBuilder(baseSiteUrl.TrimEnd('/') + "/wp-json/wp/v2/posts?");
                apiUrl.Append("per_page=").Append(perPage);
                apiUrl.Append("&page=").Append(page);
                apiUrl.Append("&_fields=id,slug,link,title,content,categories,yoast_head_json");

                if (!string.IsNullOrWhiteSpace(searchQuery))
                    apiUrl.Append("&search=").Append(Uri.EscapeDataString(searchQuery.Trim()));
                else if (categoryId > 0)
                    apiUrl.Append("&categories=").Append(categoryId);

                string jsonRaw = DownloadStringWithHeaders(apiUrl.ToString());
                if (string.IsNullOrWhiteSpace(jsonRaw) || !jsonRaw.TrimStart().StartsWith("["))
                {
                    statusMessage = sourceLabel + " API yanıt vermedi.";
                    return results;
                }

                JavaScriptSerializer ser = new JavaScriptSerializer();
                ser.MaxJsonLength = int.MaxValue;
                object[] posts = ser.Deserialize<object[]>(jsonRaw);
                if (posts == null || posts.Length == 0)
                {
                    statusMessage = sourceLabel + " üzerinde sonuç bulunamadı.";
                    return results;
                }

                foreach (object postObj in posts)
                {
                    Dictionary<string, object> post = postObj as Dictionary<string, object>;
                    if (post == null) continue;

                    GameProfile gp = ParseWpPostObjectToGameProfile(post, sourceLabel);
                    if (gp != null && !string.IsNullOrWhiteSpace(gp.Name))
                    {
                        if (gp.Name.IndexOf("Upcoming Repacks", StringComparison.OrdinalIgnoreCase) >= 0) continue;
                        results.Add(gp);
                    }
                }

                statusMessage = string.Format("✔ {0}: {1} oyun yüklendi (Sayfa {2})", sourceLabel, results.Count, page);
                return results;
            }
            catch (Exception ex)
            {
                statusMessage = sourceLabel + " bağlantı uyarısı: " + ex.Message;
                return results;
            }
        }

        private static GameProfile ParseWpPostObjectToGameProfile(Dictionary<string, object> post, string sourceLabel)
        {
            try
            {
                string slug = post.ContainsKey("slug") ? Convert.ToString(post["slug"]) : "";
                string link = post.ContainsKey("link") ? Convert.ToString(post["link"]) : "";

                string rawTitle = "";
                if (post.ContainsKey("title") && post["title"] is Dictionary<string, object>)
                {
                    Dictionary<string, object> titleDict = (Dictionary<string, object>)post["title"];
                    if (titleDict.ContainsKey("rendered"))
                        rawTitle = Convert.ToString(titleDict["rendered"]);
                }

                string cleanName = CleanGameTitle(rawTitle);
                if (string.IsNullOrWhiteSpace(cleanName)) return null;

                string contentHtml = "";
                if (post.ContainsKey("content") && post["content"] is Dictionary<string, object>)
                {
                    Dictionary<string, object> contentDict = (Dictionary<string, object>)post["content"];
                    if (contentDict.ContainsKey("rendered"))
                        contentHtml = Convert.ToString(contentDict["rendered"]);
                }

                string ogImage = "";
                try
                {
                    if (post.ContainsKey("yoast_head_json") && post["yoast_head_json"] is Dictionary<string, object>)
                    {
                        Dictionary<string, object> yoast = (Dictionary<string, object>)post["yoast_head_json"];
                        if (yoast.ContainsKey("og_image") && yoast["og_image"] is object[])
                        {
                            object[] imgs = (object[])yoast["og_image"];
                            if (imgs.Length > 0 && imgs[0] is Dictionary<string, object>)
                            {
                                Dictionary<string, object> firstImg = (Dictionary<string, object>)imgs[0];
                                if (firstImg.ContainsKey("url"))
                                    ogImage = Convert.ToString(firstImg["url"]);
                            }
                        }
                    }
                }
                catch { }

                if (string.IsNullOrEmpty(ogImage) && !string.IsNullOrEmpty(contentHtml))
                {
                    Match imgMatch = Regex.Match(contentHtml, "https?://[^\"'\\s<>]+\\.(?:jpg|jpeg|png|webp)", RegexOptions.IgnoreCase);
                    if (imgMatch.Success) ogImage = imgMatch.Value;
                }

                string categoryTag = string.IsNullOrEmpty(sourceLabel) ? "Repack" : sourceLabel;
                string version = ExtractVersionFromTitle(rawTitle);
                string desc = StripHtmlTags(contentHtml);
                if (desc.Length > 500) desc = desc.Substring(0, 500);

                return new GameProfile
                {
                    Id = "src_" + (string.IsNullOrEmpty(slug) ? MakeSlugFromName(cleanName) : slug),
                    Name = cleanName,
                    Category = categoryTag,
                    Version = version,
                    RemoteVersion = version,
                    DownloadUrl = link,
                    DirectMirrorUrl = "",
                    Description = desc,
                    BannerUrl = ogImage ?? "",
                    CapsuleUrl = ogImage ?? "",
                    FileSize = "Bilinmiyor",
                    MaxPlayers = "Singleplayer"
                };
            }
            catch { return null; }
        }

        private static List<GameProfile> FetchGenericHtmlCatalog(
            string baseSiteUrl,
            string sourceLabel,
            string searchQuery,
            int page,
            int perPage,
            out string statusMessage)
        {
            statusMessage = "";
            List<GameProfile> results = new List<GameProfile>();

            try
            {
                string url;
                bool is1337x = baseSiteUrl.IndexOf("1337x", StringComparison.OrdinalIgnoreCase) >= 0;

                if (is1337x)
                {
                    if (!string.IsNullOrWhiteSpace(searchQuery))
                        url = baseSiteUrl.TrimEnd('/') + "/search/" + Uri.EscapeDataString(searchQuery.Trim()) + "/" + Math.Max(1, page) + "/";
                    else
                        url = baseSiteUrl.TrimEnd('/') + "/cat/Games/" + Math.Max(1, page) + "/";
                }
                else
                {
                    if (!string.IsNullOrWhiteSpace(searchQuery))
                        url = baseSiteUrl.TrimEnd('/') + "/?s=" + Uri.EscapeDataString(searchQuery.Trim()) + "&paged=" + Math.Max(1, page);
                    else
                        url = baseSiteUrl.TrimEnd('/') + "/page/" + Math.Max(1, page) + "/";
                }

                string html = DownloadStringWithHeaders(url);
                if (string.IsNullOrWhiteSpace(html))
                    html = FetchViaJinaReader(url);
                if (string.IsNullOrWhiteSpace(html))
                {
                    statusMessage = sourceLabel + " yanıt vermedi.";
                    return results;
                }

                HashSet<string> seenLinks = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

                if (is1337x)
                {
                    MatchCollection m1337 = Regex.Matches(html,
                        @"href=[""'](/torrent/\d+/[^""'#]+)[""'][^>]*>([^<]{3,120})</a>",
                        RegexOptions.IgnoreCase);
                    foreach (Match m in m1337)
                    {
                        if (results.Count >= perPage) break;
                        string href = m.Groups[1].Value;
                        string title = WebUtility.HtmlDecode(StripHtmlTags(m.Groups[2].Value)).Trim();
                        if (string.IsNullOrWhiteSpace(title)) continue;

                        string fullLink = href.StartsWith("http") ? href : baseSiteUrl.TrimEnd('/') + href;
                        if (!seenLinks.Add(fullLink)) continue;

                        string cleanName = CleanGameTitle(title);
                        if (string.IsNullOrWhiteSpace(cleanName)) cleanName = title;
                        string slug = MakeSlugFromName(cleanName);

                        results.Add(new GameProfile
                        {
                            Id = "src_" + sourceLabel.ToLowerInvariant() + "_" + slug,
                            Name = cleanName,
                            Category = sourceLabel,
                            Version = ExtractVersionFromTitle(title),
                            RemoteVersion = ExtractVersionFromTitle(title),
                            DownloadUrl = fullLink,
                            DirectMirrorUrl = "",
                            Description = sourceLabel + " kaynağından listelendi.",
                            BannerUrl = "",
                            CapsuleUrl = "",
                            FileSize = "Bilinmiyor",
                            MaxPlayers = "Singleplayer"
                        });
                    }
                }
                else
                {
                    MatchCollection articles = Regex.Matches(html,
                        @"<article[^>]*>.*?<h[1-4][^>]*>.*?<a[^>]+href=[""']([^""']+)[""'][^>]*>(.*?)</a>.*?</h[1-4]>.*?</article>",
                        RegexOptions.IgnoreCase | RegexOptions.Singleline);

                    if (articles.Count == 0)
                    {
                        articles = Regex.Matches(html,
                            @"<h[1-3][^>]*class=[""'][^""']*(?:entry-title|post-title|title)[^""']*[""'][^>]*>.*?<a[^>]+href=[""']([^""']+)[""'][^>]*>(.*?)</a>",
                            RegexOptions.IgnoreCase | RegexOptions.Singleline);
                    }

                    if (articles.Count == 0)
                    {
                        string domainHost = "";
                        try { domainHost = new Uri(baseSiteUrl).Host.Replace("www.", ""); } catch { domainHost = ""; }
                        string hostPattern = string.IsNullOrEmpty(domainHost) ? "[^\"']+" : Regex.Escape(domainHost);
                        articles = Regex.Matches(html,
                            @"<a[^>]+href=[""'](https?://[^""']*" + hostPattern + @"[^""']+)[""'][^>]*>([^<]{8,120})</a>",
                            RegexOptions.IgnoreCase);
                    }

                    foreach (Match m in articles)
                    {
                        if (results.Count >= perPage) break;
                        string href = WebUtility.HtmlDecode(m.Groups[1].Value.Trim());
                        string rawTitle = WebUtility.HtmlDecode(StripHtmlTags(m.Groups[2].Value)).Trim();
                        if (string.IsNullOrWhiteSpace(rawTitle) || rawTitle.Length < 3) continue;
                        if (Regex.IsMatch(rawTitle, "^(page\\s*\\d+|home|next|previous|read more)$", RegexOptions.IgnoreCase)) continue;
                        if (href.Contains("/category/") || href.Contains("/tag/") || href.Contains("/author/") || href.Contains("/page/") || href.Contains("#")) continue;

                        if (href.StartsWith("/")) href = baseSiteUrl.TrimEnd('/') + href;
                        if (!href.StartsWith("http", StringComparison.OrdinalIgnoreCase)) continue;
                        if (!seenLinks.Add(href)) continue;

                        string cleanName = CleanGameTitle(rawTitle);
                        if (string.IsNullOrWhiteSpace(cleanName)) cleanName = rawTitle;
                        if (cleanName.Length < 2) continue;

                        string slug = MakeSlugFromName(cleanName);
                        results.Add(new GameProfile
                        {
                            Id = "src_" + sourceLabel.ToLowerInvariant() + "_" + slug,
                            Name = cleanName,
                            Category = sourceLabel,
                            Version = ExtractVersionFromTitle(rawTitle),
                            RemoteVersion = ExtractVersionFromTitle(rawTitle),
                            DownloadUrl = href,
                            DirectMirrorUrl = "",
                            Description = sourceLabel + " kaynağından listelendi.",
                            BannerUrl = "",
                            CapsuleUrl = "",
                            FileSize = "Bilinmiyor",
                            MaxPlayers = "Singleplayer"
                        });
                    }
                }

                if (results.Count > 0)
                    statusMessage = string.Format("✔ {0}: {1} oyun listelendi (Sayfa {2})", sourceLabel, results.Count, page);
                else
                    statusMessage = sourceLabel + " üzerinde sonuç bulunamadı.";
                return results;
            }
            catch (Exception ex)
            {
                statusMessage = sourceLabel + " bağlantı uyarısı: " + ex.Message;
                return results;
            }
        }

        public static SitePageAnalysis AnalyzeGamePage(string postUrl, string expectedName)
        {
            if (string.IsNullOrEmpty(postUrl)) return new SitePageAnalysis { Success = false, ErrorMessage = "Boş URL" };

            string cacheKey = postUrl;
            lock (AnalysisCache)
            {
                Tuple<DateTime, SitePageAnalysis> cached;
                if (AnalysisCache.TryGetValue(cacheKey, out cached))
                {
                    if ((DateTime.Now - cached.Item1).TotalMinutes < 30) return cached.Item2;
                    AnalysisCache.Remove(cacheKey);
                }
            }

            SitePageAnalysis analysis = new SitePageAnalysis();
            try
            {
                string html = DownloadStringWithHeaders(postUrl);
                if (string.IsNullOrWhiteSpace(html)) html = FetchViaJinaReader(postUrl);
                if (string.IsNullOrWhiteSpace(html)) { analysis.Success = false; analysis.ErrorMessage = "Sayfa indirilemedi."; return analysis; }

                analysis.CleanDescription = StripHtmlTags(Regex.Match(html, @"<div[^>]+class=[""'][^""']*(?:entry-content|post-content|description)[^""']*[""'][^>]*>([\s\S]*?)</div>", RegexOptions.IgnoreCase).Groups[1].Value);
                if (string.IsNullOrEmpty(analysis.CleanDescription))
                    analysis.CleanDescription = StripHtmlTags(Regex.Match(html, @"<p[^>]*>([\s\S]{100,800})</p>", RegexOptions.IgnoreCase).Groups[1].Value);
                if (analysis.CleanDescription != null && analysis.CleanDescription.Length > 800)
                    analysis.CleanDescription = analysis.CleanDescription.Substring(0, 800);

                analysis.CoverImageUrl = ExtractFirstImage(html, postUrl);
                analysis.LiveVersion = ExtractVersionFromTitle(html);
                analysis.Mirrors = ExtractMirrors(html, postUrl);

                analysis.Success = analysis.Mirrors.Count > 0 || !string.IsNullOrEmpty(analysis.CleanDescription);
                analysis.ResolvedPostUrl = postUrl;

                lock (AnalysisCache)
                {
                    AnalysisCache[cacheKey] = Tuple.Create(DateTime.Now, analysis);
                }
            }
            catch (Exception ex)
            {
                analysis.Success = false;
                analysis.ErrorMessage = ex.Message;
            }
            return analysis;
        }

        private static string ExtractVersionFromTitle(string title)
        {
            if (string.IsNullOrEmpty(title)) return "";
            try
            {
                Match m = Regex.Match(title, @"\[v?([0-9]+\.[0-9\.\w\-]+)\]", RegexOptions.IgnoreCase);
                if (m.Success) return "v" + m.Groups[1].Value.Trim();
                m = Regex.Match(title, @"\bv?([0-9]+\.[0-9]+\.[0-9]+[A-Za-z0-9\.\-]*)\b");
                if (m.Success) return "v" + m.Groups[1].Value.Trim();
                m = Regex.Match(title, @"\bBuild[\s\.]*([0-9]{5,})\b", RegexOptions.IgnoreCase);
                if (m.Success) return "Build " + m.Groups[1].Value.Trim();
            }
            catch { }
            return "";
        }

        private static string MakeSlugFromName(string name)
        {
            if (string.IsNullOrWhiteSpace(name)) return "game";
            string s = name.ToLowerInvariant();
            s = Regex.Replace(s, @"[^a-z0-9]+", "-");
            s = s.Trim('-');
            if (s.Length > 48) s = s.Substring(0, 48).TrimEnd('-');
            if (string.IsNullOrEmpty(s)) s = "game";
            return s;
        }

        private static string CleanGameTitle(string title)
        {
            if (string.IsNullOrEmpty(title)) return title;
            string t = WebUtility.HtmlDecode(title);
            t = Regex.Replace(t, @"<[^>]+>", " ");
            t = Regex.Replace(t, @"\s+", " ").Trim();
            // remove common repack tags
            t = Regex.Replace(t, @"\s*[-–|]\s*(FitGirl|DODI|ElAmigos|GOG|SteamRIP|Repack|Direct Play).*$", "", RegexOptions.IgnoreCase);
            t = Regex.Replace(t, @"\(?\s*(Free Download|PC Game|Repack|ISO|Direct Link)\s*\)?", "", RegexOptions.IgnoreCase);
            t = Regex.Replace(t, @"\s+", " ").Trim();
            if (t.Length > 120) t = t.Substring(0, 120).Trim();
            return t;
        }

        private static string StripHtmlTags(string html)
        {
            if (string.IsNullOrEmpty(html)) return "";
            string t = Regex.Replace(html, @"<script[^>]*>[\s\S]*?</script>", " ", RegexOptions.IgnoreCase);
            t = Regex.Replace(t, @"<style[^>]*>[\s\S]*?</style>", " ", RegexOptions.IgnoreCase);
            t = Regex.Replace(t, @"<[^>]+>", " ");
            t = WebUtility.HtmlDecode(t);
            t = Regex.Replace(t, @"\s+", " ").Trim();
            return t;
        }

